{
	"name": "liquidx-carto",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"odpt": "node --env-file-if-exists=.env tools/odpt.ts",
		"ekispert": "node --env-file-if-exists=.env tools/ekispert.ts",
		"ev-jp": "node tools/ev-jp.ts",
		"diorama-glb": "node --import ./tools/node-env.ts tools/diorama-glb.ts",
		"diorama-scene": "node tools/diorama-scene.ts",
		"snowboard-locations": "node tools/snowboard-locations.ts",
		"tessera-classifier": "node tools/tessera-classifier.ts",
		"japan-train-lines": "node tools/japan-train-lines.ts",
		"tokyo-outline": "node --import ./tools/node-env.ts tools/tokyo-outline.ts"
	},
	"devDependencies": {
		"@duckdb/node-api": "1.5.6-r.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24",
		"@types/pngjs": "^6.0.5",
		"@types/three": "^0.186.0",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"open-data-jp-prefectures-geojson": "^1.1.0",
		"playwright": "^1.60.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@liquidx/diorama": "workspace:*",
		"@lucide/svelte": "^1.48.0",
		"fflate": "^0.8.3",
		"maplibre-gl": "^6.11.1",
		"proj4": "^2.22.0",
		"three": "^0.186.0",
		"zarrita": "^0.7.5"
	}
}
