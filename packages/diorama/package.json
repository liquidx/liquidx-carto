{
	"name": "@liquidx/diorama",
	"version": "0.7.1",
	"description": "Svelte viewer for terrain diorama GLBs exported from liquidx-carto, with the contour and soil shader.",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepack": "pnpm run build"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./models/*": "./src/models/*"
	},
	"publishConfig": {
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./models/*": "./dist/models/*"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"three": ">=0.170.0"
	},
	"dependencies": {
		"@types/geojson": "^7946.0.16"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@types/three": "^0.186.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"three": "^0.186.0",
		"typescript": "^6.0.3"
	}
}
