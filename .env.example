# See https://console.cloud.google.com/apis/credentials?project=liquidx-maps
GOOGLE_MAPS_API_KEY=

# ODPT access token from https://developer.odpt.org/ (basic-license feeds, e.g. Tokyo Metro)
# https://developer.odpt.org/editkeys
ODPT_ACCESS_TOKEN=

# Open Data Challenge token (Keio, JR East, Tobu, Sotetsu); falls back to ODPT_ACCESS_TOKEN
# https://developer.odpt.org/challengeeditkeys
ODPT_CHALLENGE_ACCESS_TOKEN=

# 駅すぱあと API access key (trial or free plan) from https://api-info.ekispert.com/
EKISPERT_API_KEY=
